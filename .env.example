# Supabase (required for auth, database, storage). Create a project at
# https://supabase.com, run the SQL in supabase/migrations/0001_init.sql
# against it, then fill these in.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google Maps JS API key, for the map view on the home page.
# https://console.cloud.google.com/google/maps-apis
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Tap Payments secret key, for deposit charges (mada / Apple Pay).
# https://www.tap.company — omit to simulate successful deposits in dev.
TAP_SECRET_KEY=

# Resend API key, for booking confirmation emails.
# https://resend.com — omit to just log the email payload in dev.
RESEND_API_KEY=
